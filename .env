# Timezone
TZ=Asia/Kolkata

# User and Group ID for file permissions.
PUID=1000
PGID=1000

# Base directory for storing Docker application data
BASE_DATA_PATH=<path-to-your-data-location>

# Bento-pdf
BENTOPDF_VERSION=latest

# Beszel
BESZEL_VERSION=latest
BESZELAGENT_VERSION=latest

# Pihole
FTLCONF_webserver_api_password=''
DNS_LISTENINGMODE='ALL'
FTLCONF_webserver_domain=<your-pihole-domain>
DHCP_ACTIVE=false
DHCP_IPV6_ACTIVE=false
NTP_IPV4_ACTIVE=false
NTP_IPV6_ACTIVE=false
NTP_SYNC_ACTIVE=false
#performance tuning
FTLCONF_dns_analyzeOnlyAandAAAA='true'
FTLCONF_resolver_resolveIPv6='true'
FTLCONF_dns_rateLimit_count=0
FTLCONF_dns_rateLimit_interval=0
FTLCONF_database_maxDBdays=30
FTLCONF_dns_cache_size=0
FTLCONF_misc_etc_dnsmasq_d=true

# Stirling Pdf
STIRLINGPDF_VERSION=latest

# Traefik
ROOT_DOMAIN=<your domain>
ACME_EMAIL=<acme-email>
TRAEFIK_VERSION=v3.7

# Vaultwarden
VAULTWARDEN_VERSION=latest
ADMIN_TOKEN=''
SIGNUPS_ALLOWED=true
SHOW_PASSWORD_HINT=false